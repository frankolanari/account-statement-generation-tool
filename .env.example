# Trigger.dev: create a project and configure these locally.
TRIGGER_PROJECT_REF=proj_your_project_ref
TRIGGER_SECRET_KEY=
# Optional for self-hosted Trigger.dev:
# TRIGGER_API_URL=https://your-trigger-instance.example

# Database selection: postgres (default, including when unset) or snowflake.
DATABASE_PROVIDER=postgres
# Postgres only. URL includes username/password; use verified TLS.
# Not required when DATABASE_PROVIDER=snowflake.
DATABASE_URL=
# Snowflake only. Ignored when DATABASE_PROVIDER=postgres.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Key-pair authentication is the default for unattended workers.
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# PEM private key; multiline values or literal \n escapes are supported.
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Only when AUTHENTICATOR=SNOWFLAKE and account policy permits password auth:
SNOWFLAKE_PASSWORD=
# Only when AUTHENTICATOR=OAUTH or PROGRAMMATIC_ACCESS_TOKEN:
SNOWFLAKE_TOKEN=

# Only for natural-language requests. Structured lookup/generate requests do not use AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Existing PDF service endpoint WITHOUT its token query parameter.
BROWSERLESS_PDF_URL=
BROWSERLESS_TOKEN=

# Optional PDF storage. Leave STATEMENTS_BUCKET empty/unset to return the PDF as base64.
# Set a private bucket (S3, R2, or equivalent) to enable saving.
# AWS/S3 variables below are only used when a bucket is set.
STATEMENTS_BUCKET=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for non-AWS S3-compatible storage:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Server-to-server only. Never put this token in browser JavaScript.
WEBHOOK_SERVICE_TOKEN=
PORT=3001

# Slack: configure signing secret on the Trigger.dev webhook endpoint. Worker needs bot token + team ID.
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_BOT_TOKEN=
# Optional worker access lists. Empty permits mentions from the configured workspace.
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
# Web tool sign-in: comma-separated passcodes, each optionally ":YYYY-MM-DD" (expires after that UTC day).
TOOL_PASSCODES=
# One-call API: comma-separated bearer tokens of 32+ characters, same optional expiry. Generate with `npm run token`.
STATEMENT_API_TOKEN=
