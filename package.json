{
  "name": "statement-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "webhooks": "node --env-file=.env --import tsx src/http/server.ts",
    "token": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "trigger:dev": "npx trigger.dev@4.8.1 dev",
    "trigger:deploy": "npx trigger.dev@4.8.1 deploy",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@trigger.dev/sdk": "^4.8.1",
    "@trigger.dev/slack": "^4.8.1",
    "ai": "^6.0.317",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "snowflake-sdk": "^3.4.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@trigger.dev/build": "^4.8.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
